<?xml version="1.0"?>
<package format="2">
    <name>hero_chassis_controller</name>
    <version>0.1.0</version>
    <description>Hero robot Chassis controller</description>
    <maintainer email="nibeverly57@gmail.com">Beverly Ni</maintainer>
    <license>BSD</license>
    <author email="nibeverly57@gmail.com">Beverly Ni</author>

    <!-- buildtool_depend: dependencies of the build process -->
    <buildtool_depend>catkin</buildtool_depend>
    <!-- build_depend: dependencies only used in source files -->

    <!-- depend: build, export, and execution dependency -->
    <depend>roscpp</depend>
    <depend>roslint</depend>
    <depend>controller_interface</depend>
    <depend>hardware_interface</depend>
    <depend>pluginlib</depend>

    <exec_depend>xacro</exec_depend>
    <export>
        <controller_interface plugin="${prefix}/hero_chassis_controller_plugins.xml"/>
    </export>
</package>